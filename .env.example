# Used by docker-compose.yml. Copy to .env in this same directory:
#   cp .env.example .env
# then fill in GROQ_API_KEY.

# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the model used for SQL generation and description generation
SQLSCRIBE_MODEL=llama-3.3-70b-versatile

# Optional: only needed if the browser can't reach the backend at
# http://localhost:8000 (e.g. deploying behind a domain/reverse proxy)
VITE_API_BASE=http://localhost:8000
