# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional: override the model used for SQL generation
SQLSCRIBE_MODEL=llama-3.3-70b-versatile

# Optional: comma-separated list of frontend origins allowed to call this
# API. Defaults to the standard local Vite dev/preview ports if unset.
# ALLOWED_ORIGINS=http://localhost:5173,https://your-deployed-frontend.example.com

# Optional: max seconds a single generated query is allowed to run before
# being cancelled server-side. Default 25.
# SQLSCRIBE_QUERY_TIMEOUT_SECONDS=25
